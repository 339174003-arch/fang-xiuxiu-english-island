page{min-height:100%;background:#fff9ec;color:#253b49;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;font-size:28rpx}button{font-family:inherit}button::after{border:0}.page{padding:28rpx 28rpx 48rpx}.card{background:#fffefa;border:1rpx solid #eee9dc;border-radius:28rpx;box-shadow:0 12rpx 35rpx rgba(67,91,68,.06)}.primary{background:#35a878;color:#fff;border-radius:22rpx;font-weight:800}.muted{color:#81929a}.tiny{font-size:22rpx}.pill{display:inline-flex;background:#fff0c9;color:#9c701f;padding:8rpx 16rpx;border-radius:999rpx;font-size:21rpx;font-weight:800}
