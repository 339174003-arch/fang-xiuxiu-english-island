.topline{display:flex;align-items:center;justify-content:space-between;margin:12rpx 4rpx 0}.page-title{display:block;font-size:36rpx;font-weight:900}.page-subtitle{display:block;margin-top:7rpx;color:#81929a;font-size:22rpx}.grade-pill{padding:10rpx 17rpx;border-radius:999rpx;background:#ffedc9;color:#a2761e;font-size:21rpx;font-weight:900}.progress{height:13rpx;margin:30rpx 2rpx 22rpx;border-radius:99rpx;background:#edf0e9;overflow:hidden}.progress-fill{height:100%;border-radius:99rpx;background:linear-gradient(90deg,#6bc995,#47b78a);transition:width .25s}.word-card{padding:34rpx 24rpx 32rpx;text-align:center;background:#f6f8f0}.emoji,.english,.translation{display:block}.emoji{font-size:76rpx}.english{margin:12rpx 0;font-size:41rpx;line-height:1.35;font-weight:900;word-break:break-word}.translation{color:#82919a;font-size:27rpx}.listen-button{display:inline-block;margin:24rpx auto 0;padding:0 24rpx;border-radius:18rpx;background:#e6f6ed;color:#32845f;font-size:25rpx;line-height:72rpx;font-weight:900}.listen-button[disabled]{opacity:.55}.practice-card{margin-top:20rpx;padding:24rpx}.status{display:block;min-height:48rpx;color:#64806f;text-align:center;font-size:25rpx;line-height:1.5;font-weight:800}.status.success{color:#319366}.meter{height:15rpx;margin:10rpx auto 18rpx;border-radius:99rpx;background:#e2eade;overflow:hidden}.meter-fill{height:100%;border-radius:99rpx;background:linear-gradient(90deg,#7bd29e,#42ad82);transition:width .08s}.actions{display:flex;gap:14rpx}.actions button{flex:1;margin:0;padding:0;border-radius:18rpx;font-size:24rpx;line-height:76rpx;font-weight:900}.mic-button{box-shadow:0 6rpx 0 #24865d}.mic-button[disabled]{opacity:.48;box-shadow:none}.next-button{background:#f5d990;color:#71551b}.next-button[disabled]{opacity:.42;color:#8c876f}.privacy{display:block;margin-top:17rpx;color:#84938a;font-size:20rpx;line-height:1.55}.result{margin-top:120rpx;padding:48rpx 34rpx;text-align:center}.result-emoji,.result-title,.result-copy{display:block}.result-emoji{font-size:100rpx}.result-title{margin-top:12rpx;font-size:40rpx;font-weight:900}.result-copy{margin:18rpx 0 30rpx;color:#81929a;font-size:25rpx;line-height:1.6}.result-button{width:100%;font-size:27rpx;line-height:82rpx}
